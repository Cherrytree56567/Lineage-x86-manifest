  <project path="vendor/pixel-framework" name="platform_vendor_pixel-framework" remote="BlissRoms" />
  <project path="vendor/qcom/opensource/libfmjni" name="platform_vendor_qcom_opensource_libfmjni" remote="BlissRoms" />
